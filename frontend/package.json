    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "axios": "^1.20.0",
    "campus-recruitment-progress-e2e": "file:..",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "vuetify": "^3.9.0"
