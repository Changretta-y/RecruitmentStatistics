{
  "name": "campus-recruitment-progress-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend environment baseline for the campus recruitment progress management system",
  "engines": {
    "node": "20.19.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite --config src/vite.config.ts",
